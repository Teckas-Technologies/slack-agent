# ======================
# REQUIRED - Slack Configuration
# ======================
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# ======================
# REQUIRED - AI Services (at least one)
# ======================
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ======================
# REQUIRED - Google Drive Configuration
# ======================
# Option 1: Paste JSON content directly (recommended)
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service@your-project.iam.gserviceaccount.com",...}'

# Option 2: Or use file path (for local development)
# GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json

# Domain-Wide Delegation (for Google Workspace organizations)
# Leave empty if using manual folder sharing
# Set to an admin or user email to enable domain-wide delegation
GOOGLE_DRIVE_DELEGATED_USER=admin@yourcompany.com
# For manual sharing: Leave blank or remove this line
# GOOGLE_DRIVE_DELEGATED_USER=

# ======================
# VertexAI RAG Configuration (RECOMMENDED for 2000+ documents)
# ======================
# Enable VertexAI RAG for Google Drive documents (better performance for large document sets)
USE_VERTEX_AI_RAG=true

# Google Cloud Project Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=europe-west1

# VertexAI RAG Corpus Name (optional, defaults to "google_drive_documents")
VERTEX_RAG_CORPUS_NAME=google_drive_documents

# ===== Import Mode Configuration =====
# Choose ONE of the two options below:

# OPTION 1: Specific Folders (RECOMMENDED - Auto-sync enabled!)
# VertexAI automatically detects and indexes new files added to these folders
# No periodic sync needed after initial import
# Provide comma-separated list of Google Drive folder IDs
# How to get folder ID: Open folder in Drive, copy ID from URL
# Example URL: https://drive.google.com/drive/folders/1a2b3c4d5e6f7g8h9i0j
# The folder ID is: 1a2b3c4d5e6f7g8h9i0j
GOOGLE_DRIVE_FOLDER_IDS=1a2b3c4d5e6f7g8h9i0j,2b3c4d5e6f7g8h9i0j1k
# Leave empty if using Option 2:
# GOOGLE_DRIVE_FOLDER_IDS=

# OPTION 2: Full Drive Access (Requires periodic sync)
# Import ALL files the service account can access
# Periodic sync runs every 2 minutes to discover new files
# Only use if you can't specify folders or need everything
VERTEX_RAG_FULL_DRIVE=false
# Set to true if you want to index entire accessible Drive:
# VERTEX_RAG_FULL_DRIVE=true

# ======================
# OPTIONAL - Confluence Configuration (Only used with ChromaDB mode)
# ======================
# Note: Confluence is not supported with VertexAI RAG mode
# Set USE_VERTEX_AI_RAG=false to enable Confluence support
CONFLUENCE_BASE_URL=https://your-company.atlassian.net
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# Confluence Spaces to Index
# Leave empty to automatically fetch ALL accessible spaces (recommended)
CONFLUENCE_SPACES=
# Or specify specific spaces (comma-separated, no spaces):
# CONFLUENCE_SPACES=DEV,PM,DOCS

# ======================
# Application Settings
# ======================
# ChromaDB path (only used when USE_VERTEX_AI_RAG=false)
CHROMA_DB_PATH=./chroma_db
PORT=8000
DEBUG=False
HOST=0.0.0.0

# ======================
# OPTIONAL - SSL/HTTPS Configuration
# (Only needed for production deployments with HTTPS)
# ======================
# SSL_CERT=./ssl_certs/cert.pem
# SSL_KEY=./ssl_certs/key.pem
