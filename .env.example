# ======================
# REQUIRED - Slack Configuration
# ======================
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# ======================
# REQUIRED - AI Services (at least one)
# ======================
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ======================
# REQUIRED - Google Drive Configuration
# ======================
# Option 1: Paste JSON content directly (recommended)
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service@your-project.iam.gserviceaccount.com",...}'

# Option 2: Or use file path (for local development)
# GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json

# Domain-Wide Delegation (for Google Workspace organizations)
# Leave empty if using manual folder sharing
# Set to an admin or user email to enable domain-wide delegation
GOOGLE_DRIVE_DELEGATED_USER=admin@yourcompany.com
# For manual sharing: Leave blank or remove this line
# GOOGLE_DRIVE_DELEGATED_USER=

# ======================
# OPTIONAL - Confluence Configuration
# ======================
CONFLUENCE_BASE_URL=https://your-company.atlassian.net
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# Confluence Spaces to Index
# Leave empty to automatically fetch ALL accessible spaces (recommended)
CONFLUENCE_SPACES=
# Or specify specific spaces (comma-separated, no spaces):
# CONFLUENCE_SPACES=DEV,PM,DOCS

# ======================
# Application Settings
# ======================
CHROMA_DB_PATH=./chroma_db
PORT=8000
DEBUG=False
HOST=0.0.0.0

# ======================
# OPTIONAL - SSL/HTTPS Configuration
# (Only needed for production deployments with HTTPS)
# ======================
# SSL_CERT=./ssl_certs/cert.pem
# SSL_KEY=./ssl_certs/key.pem
